# STLC frontend development server. Chosen to avoid applications commonly using 5173/5174.
VITE_DEV_PORT=5175

# Vite proxies same-origin /api requests to the STLC backend.
VITE_API_PROXY_TARGET=http://localhost:8100

# Leave empty for same-origin requests through the Vite proxy. Set an absolute URL only
# when the frontend is deployed separately from the backend.
VITE_API_BASE_URL=
